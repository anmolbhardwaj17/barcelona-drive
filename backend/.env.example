# Backend runtime config. Copy to `.env` or set in your host's environment. Only needed for the Node-server
# deploy (a pure-static CDN deploy doesn't run this server at all).

# Port to listen on.
PORT=4041

# Set to "production" to enable hard immutable caching on tiles/citymap (returning players re-download
# nothing). Leave unset in dev so a re-bake shows up immediately.
NODE_ENV=production

# Comma-separated CORS allowlist — your deployed frontend origin(s). Use "*" for a fully public tile API.
# Defaults to http://localhost:4040 (the dev frontend) if unset.
ALLOWED_ORIGINS=https://your-frontend.example

# Default region when a request omits ?region= .
REGION=barcelona
