# Frontend build-time config (Vite). Copy to `.env` locally, or set these in your host's build environment.
# These are inlined at BUILD time, so you must rebuild after changing them.

# Base URL that serves the tiles + citymap. In production set this to your deployed tile host
# (your backend URL, or the CDN/object-storage origin holding the static tiles).
# If unset, the build falls back to http://localhost:4041 — which breaks a deployed site.
VITE_MAP_API=http://localhost:4041

# Region to load — must match the baked tiles directory: backend/tiles/<region>/
VITE_TILE_REGION=barcelona

# Set to 1 to fetch tiles as PLAIN STATIC FILES (/tiles/<region>/<z>/<x>/<y>.bin) instead of the Express
# /api route — lets the whole app run on a static CDN / object store with NO server. Leave unset for the
# Node backend deploy.
# VITE_STATIC_TILES=1
