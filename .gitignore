data/regions/
backend/data/regions/
*.pbf
*.osm.pbf
*.tif
*.tiff
*.dem

# ── Bake pipeline state ──────────────────────────────────────
bake/

# ── Build output ─────────────────────────────────────────────
dist/
build/
frontend/dist/
frontend/build/

# ── Editor / OS / tooling ────────────────────────────────────
.DS_Store
**/.DS_Store
.cursor/
.claude/
*.log
npm-debug.log*

# ── Env / secrets ────────────────────────────────────────────
.env
.env.*
!.env.example
art-src/

